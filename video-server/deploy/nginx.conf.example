# Install inside an HTTPS server{} for the SAME origin as the student site.
# TLS certificate/domain setup is intentionally left to the actual VPS setup.
# Serve the built frontend as ordinary static files. Never alias VIDEO_ROOT.
location ^~ /api/video/ {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Cookie $http_cookie;
    proxy_buffering off;
    proxy_cache off;
    client_max_body_size 2k;
    # Grants are confidential; do not put playback URLs in access logs.
    access_log off;
}

