# Public Firebase project identifier, same project as the student application.
FIREBASE_PROJECT_ID=replace-with-project-id
# Path outside the source tree to a least-privilege service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-video-service.json
# Generate privately: openssl rand -hex 32
VIDEO_SIGNING_SECRET=replace-with-at-least-64-random-characters
VIDEO_ROOT=/srv/dulces-victoria/private-hls
# Student site origin. Production requires HTTPS and same-origin /api/video proxy.
APP_ORIGIN=https://replace-with-your-domain.example
PORT=8081
HOST=127.0.0.1
GRANT_TTL_SECONDS=300
MAX_SESSIONS=500
NODE_ENV=production
