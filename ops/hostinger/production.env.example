# Copy to /etc/dulces-victoria/production.env on the VPS only; chmod 600.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
VIDEO_STORAGE=local
VIDEO_ROOT=/srv/videos
FIREBASE_API_KEY=AIzaSyCIGKuz6aUJN6Zh1XyMuREHats9eUKAj0M
FIREBASE_AUTH_DOMAIN=dulces-victoria-7cf8f.firebaseapp.com
FIREBASE_PROJECT_ID=dulces-victoria-7cf8f
# Public config retained for SDK compatibility. No Firebase Storage usage required.
FIREBASE_STORAGE_BUCKET=dulces-victoria-7cf8f.firebasestorage.app
FIREBASE_APP_ID=1:917216788347:web:151262c335da2dd04907de
# Dedicated account, least permissions for Auth lookup and Firestore required.
# Obtain/configure through a secure channel; never commit private keys.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Generate securely on the server; minimum 32 random characters.
VIDEO_TOKEN_SECRET=
# Only because Nginx connects on loopback and overwrites X-Real-IP.
TRUST_LOOPBACK_PROXY=true
