# Replace DOMAIN with the verified school domain. Install HTTPS with Certbot
# before opening the site; this HTTP vhost is only the initial ACME/bootstrap stage.
server {
    listen 80;
    server_name DOMAIN;
    server_tokens off;
    client_max_body_size 16k;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $request_id;
        proxy_buffering off;
        proxy_read_timeout 90s;
        # Video URLs contain short-lived signed playback tokens. Do not log queries.
        access_log off;
    }
    location ~ /\. { deny all; }
}
