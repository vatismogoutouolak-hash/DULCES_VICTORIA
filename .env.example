# Public Firebase web application configuration (not service-account credentials)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=
# Server-only service account (never place in client code)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Random server-only HMAC secret, at least 32 characters. Rotate to expire playback tokens.
VIDEO_TOKEN_SECRET=
